{
  "name": "audit-readiness-app",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --project convex/tsconfig.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:synthetic": "tsx scripts/generate-synthetic.ts",
    "test": "node --import tsx --test --test-reporter=spec tests/unit/*.test.ts",
    "test:browser": "playwright test --reporter=list",
    "seed:dev": "node scripts/seed-dev.mjs",
    "build:m1-flags": "tsx scripts/build-m1-flags.ts",
    "eval:m1": "node --import tsx scripts/eval-m1.mjs",
    "deploy": "VITE_STORY=1 npx @convex-dev/static-hosting deploy",
    "deploy:dev": "node scripts/deploy-dev.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "0.2.1",
    "convex": "1.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.81.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": "24.15.0"
  }
}
